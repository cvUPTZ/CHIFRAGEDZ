{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Algerian BTP contractor or Bureau d'Etudes profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 120 },
        "companyName": { "type": "string", "maxLength": 160 },
        "defaultWilayaCode": { "type": "string", "maxLength": 4, "pattern": "^[0-9]{2}$" },
        "preferredLang": { "type": "string", "enum": ["fr", "ar"] },
        "rc": { "type": "string", "maxLength": 60 },
        "nif": { "type": "string", "maxLength": 40 },
        "nis": { "type": "string", "maxLength": 40 },
        "ai": { "type": "string", "maxLength": 40 },
        "rib": { "type": "string", "maxLength": 60 },
        "qualification": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "companyName", "defaultWilayaCode", "preferredLang", "createdAt", "updatedAt"]
    },
    "Tender": {
      "title": "Tender",
      "description": "Public tender BQE project owned by a contractor",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 240 },
        "reference": { "type": "string", "maxLength": 100 },
        "clientName": { "type": "string", "maxLength": 200 },
        "wilayaCode": { "type": "string", "maxLength": 4, "pattern": "^[0-9]{2}$" },
        "wilayaName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["draft", "auditing", "rfq_pending", "ready_to_submit", "submitted"] },
        "globalTransportPct": { "type": "number" },
        "globalOccupiedSitePct": { "type": "number" },
        "globalOverheadPct": { "type": "number" },
        "globalMarginPct": { "type": "number" },
        "tvaRate": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "reference", "clientName", "wilayaCode", "wilayaName", "status", "globalTransportPct", "globalOccupiedSitePct", "globalOverheadPct", "globalMarginPct", "tvaRate", "createdAt", "updatedAt"]
    },
    "TenderLot": {
      "title": "TenderLot",
      "description": "Lot grouping inside a tender with optional cost-to-bid overrides",
      "type": "object",
      "properties": {
        "tenderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 40 },
        "name": { "type": "string", "maxLength": 200 },
        "orderIndex": { "type": "number" },
        "overrideTransportPct": { "type": "number" },
        "overrideOccupiedSitePct": { "type": "number" },
        "overrideOverheadPct": { "type": "number" },
        "overrideMarginPct": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenderId", "ownerId", "code", "name", "orderIndex", "createdAt", "updatedAt"]
    },
    "LineItem": {
      "title": "LineItem",
      "description": "Individual BQE line item with ABC class, pricing provenance, and debourse sec",
      "type": "object",
      "properties": {
        "tenderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lotId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "articleNo": { "type": "string", "maxLength": 40 },
        "designation": { "type": "string", "maxLength": 1200 },
        "rawDesignation": { "type": "string", "maxLength": 1200 },
        "unit": { "type": "string", "maxLength": 24 },
        "quantity": { "type": "number" },
        "pageNumber": { "type": "number" },
        "abcClass": { "type": "string", "enum": ["A", "B", "C"] },
        "trade": { "type": "string", "maxLength": 80 },
        "debourseSecDa": { "type": "number" },
        "confidenceRangePct": { "type": "number" },
        "priceSource": { "type": "string", "enum": ["proforma_required", "indicative_bpu", "private_bpu", "supplier_verified", "manual_override"] },
        "selectedQuoteId": { "type": "string", "maxLength": 128 },
        "selectedSupplierName": { "type": "string", "maxLength": 160 },
        "brand": { "type": "string", "maxLength": 120 },
        "normalizedKey": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenderId", "lotId", "ownerId", "articleNo", "designation", "rawDesignation", "unit", "quantity", "pageNumber", "abcClass", "trade", "debourseSecDa", "confidenceRangePct", "priceSource", "normalizedKey", "createdAt", "updatedAt"]
    },
    "Anomaly": {
      "title": "Anomaly",
      "description": "Audit flag detected during BQE ingestion",
      "type": "object",
      "properties": {
        "tenderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lineItemId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["truncated_fragment", "unit_anomaly", "hidden_cost_clause", "ocr_typo"] },
        "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "pageNumber": { "type": "number" },
        "suggestedMultiplierPct": { "type": "number" },
        "resolved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenderId", "ownerId", "type", "severity", "title", "description", "pageNumber", "resolved", "createdAt", "updatedAt"]
    },
    "PrivateBpuEntry": {
      "title": "PrivateBpuEntry",
      "description": "Contractor private BPU price memory from verified supplier quotes",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "normalizedItemKey": { "type": "string", "maxLength": 200 },
        "designation": { "type": "string", "maxLength": 500 },
        "unit": { "type": "string", "maxLength": 24 },
        "brand": { "type": "string", "maxLength": 120 },
        "wilayaCode": { "type": "string", "maxLength": 4, "pattern": "^[0-9]{2}$" },
        "wilayaName": { "type": "string", "maxLength": 80 },
        "trade": { "type": "string", "maxLength": 80 },
        "supplierName": { "type": "string", "maxLength": 160 },
        "debourseSecDa": { "type": "number" },
        "quotedDate": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "normalizedItemKey", "designation", "unit", "brand", "wilayaCode", "wilayaName", "trade", "supplierName", "debourseSecDa", "quotedDate", "createdAt", "updatedAt"]
    },
    "RfqPublicBatch": {
      "title": "RfqPublicBatch",
      "description": "Sanitized no-login Micro-RFQ batch shared with suppliers via unguessable token",
      "type": "object",
      "properties": {
        "shareToken": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trade": { "type": "string", "maxLength": 80 },
        "wilayaName": { "type": "string", "maxLength": 80 },
        "deadline": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shareToken", "tenderId", "ownerId", "trade", "wilayaName", "deadline", "status", "items", "createdAt", "updatedAt"]
    },
    "SupplierQuote": {
      "title": "SupplierQuote",
      "description": "Supplier pricing submission on a Micro-RFQ batch",
      "type": "object",
      "properties": {
        "shareToken": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "supplierName": { "type": "string", "maxLength": 160 },
        "supplierPhone": { "type": "string", "maxLength": 40 },
        "leadTimeDays": { "type": "number" },
        "notes": { "type": "string", "maxLength": 600 },
        "lineQuotes": { "type": "array" },
        "selected": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shareToken", "tenderId", "ownerId", "supplierName", "leadTimeDays", "lineQuotes", "selected", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Contractor private profile document"
    },
    "/tenders/{tenderId}": {
      "schema": { "$ref": "#/entities/Tender" },
      "description": "Public tender BQE workspace owned by a contractor"
    },
    "/tenders/{tenderId}/lots/{lotId}": {
      "schema": { "$ref": "#/entities/TenderLot" },
      "description": "Lots belonging to a tender"
    },
    "/tenders/{tenderId}/line_items/{itemId}": {
      "schema": { "$ref": "#/entities/LineItem" },
      "description": "Line items belonging to a tender"
    },
    "/tenders/{tenderId}/anomalies/{anomalyId}": {
      "schema": { "$ref": "#/entities/Anomaly" },
      "description": "Ingestion audit anomalies belonging to a tender"
    },
    "/private_bpu/{bpuId}": {
      "schema": { "$ref": "#/entities/PrivateBpuEntry" },
      "description": "Contractor private BPU price memory"
    },
    "/rfq_public/{shareToken}": {
      "schema": { "$ref": "#/entities/RfqPublicBatch" },
      "description": "Sanitized no-login supplier Micro-RFQ batch"
    },
    "/rfq_public/{shareToken}/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/SupplierQuote" },
      "description": "Quotes submitted by suppliers on a Micro-RFQ batch"
    }
  }
}
